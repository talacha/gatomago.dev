# Copy to .env.local for local development. Never commit real values.
# On Vercel these are set per environment (Production / Preview / Development).

# --- Sanity (public) -------------------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=epnbx6w4
NEXT_PUBLIC_SANITY_DATASET=production
# Canonical site URL used in emails, sitemap and metadata
NEXT_PUBLIC_SITE_URL=https://www.gatomago.dev

# --- Database (added automatically by the Vercel Marketplace Supabase integration) -----------
POSTGRES_URL=                    # pooled connection, used by the app
POSTGRES_URL_NON_POOLING=        # direct connection, used by `npm run db:migrate`
# POSTGRES_SSL=disable           # ONLY for a throwaway local test database

# --- Email (Resend; the Marketplace integration can add RESEND_API_KEY) ----------------------
RESEND_API_KEY=
# Must be on a domain verified in Resend (SPF + DKIM), e.g. "Gato Mago <hello@gatomago.dev>"
NEWSLETTER_FROM=
NEWSLETTER_REPLY_TO=

# --- Newsletter master switch ----------------------------------------------------------------
# Off unless exactly "true". When off, the sign-up form, "Join the Circle" links, the privacy page and
# sending all disappear. Unsubscribe/erase links keep working for existing subscribers.
NEWSLETTER_ENABLED=false

# --- Newsletter security and compliance ------------------------------------------------------
# 32+ random characters (openssl rand -base64 48). Signs unsubscribe links and keys the rate limiter.
NEWSLETTER_SECRET=
# Shown in every email footer and on the privacy page (CAN-SPAM / GDPR controller details)
NEWSLETTER_POSTAL_ADDRESS=
PRIVACY_CONTACT_EMAIL=
# Nothing is emailed to subscribers until this is exactly "true"
NEWSLETTER_BROADCAST_ENABLED=false

# --- Webhook and cron secrets ----------------------------------------------------------------
# Same value as configured on the Sanity webhook
SANITY_WEBHOOK_SECRET=
# Vercel Cron sends this as a Bearer token to /api/cron/cleanup
CRON_SECRET=
